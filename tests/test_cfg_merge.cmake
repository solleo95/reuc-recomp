file(MAKE_DIRECTORY ${OUT})
file(WRITE ${OUT}/a.cfg "entry 80003100\n")
file(WRITE ${OUT}/b.cfg "nofunc 80003200\n")
execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --cfg ${OUT}/a.cfg --cfg ${OUT}/b.cfg --out ${OUT}/gen RESULT_VARIABLE r)
if(r)
  message(FATAL_ERROR "translator rejected two --cfg arguments (${r})")
endif()
execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --cfg ${OUT}/a.cfg --cfg ${OUT}/missing.cfg --out ${OUT}/gen2 RESULT_VARIABLE r2)
if(NOT r2)
  message(FATAL_ERROR "translator accepted a missing --cfg file")
endif()
# the second file must really be loaded: an invalid line in it is an error
file(WRITE ${OUT}/bad.cfg "bogus 1\n")
execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --cfg ${OUT}/a.cfg --cfg ${OUT}/bad.cfg --out ${OUT}/gen3 RESULT_VARIABLE r3)
if(NOT r3)
  message(FATAL_ERROR "the second --cfg file was ignored")
endif()
# and the first one too: an invalid first file followed by a valid one must still fail
execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --cfg ${OUT}/bad.cfg --cfg ${OUT}/a.cfg --out ${OUT}/gen4 RESULT_VARIABLE r4)
if(NOT r4)
  message(FATAL_ERROR "the first --cfg file was ignored")
endif()
