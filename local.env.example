# Copy this file to local.env (git-ignored) and set the paths of your machine.
# Format: KEY=VALUE, no quotes. A comment is a line that starts with "#". Save as UTF-8 without BOM; use ASCII-only paths for build.bat.
# Read by build.bat, scripts\bringup.bat and the Python tools (scripts\localenv.py). A variable set in the shell wins over this file.

# Required to build: the folder where the game is installed. It holds game\DATA\sys\main.dol (the extracted disc, see docs/building.md).
# build.bat translates that main.dol and copies the finished build into this folder, next to game\ and saves\.
UC_INSTALL_DIR=C:\Games\Umbrella Chronicles

# Optional, development only. Remove the leading "#" of a line to use it.

# The extracted disc. Default: UC_INSTALL_DIR\game
# UC_GAME_DIR=C:\Games\Umbrella Chronicles\game

# Saves that the test harness copies for every run. Default: the pinned snapshot build\autotest\saves-pinned, else UC_INSTALL_DIR\saves.
# Live saves can change the intro and menu flow and so invalidate recorded demos.
# UC_SAVE_SOURCE=C:\Games\Umbrella Chronicles\saves

# llvm-profdata and llvm-symbolizer, when they are not on PATH.
# UC_LLVM_DIR=C:\Program Files\LLVM\bin

# A Dolphin build with the scripting API (scripts\dolphin_reference.py).
# UC_DOLPHIN=C:\Tools\Dolphin\Dolphin.exe

# scripts\deploy\install.ps1: more folders to update, ";" separates several.
# UC_DEPLOY_EXTRA=\\host\share\dist-raw
