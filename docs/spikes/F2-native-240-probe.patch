+void wait(ppc::Ctx&) {
+    start_sampler();
+    const auto period=std::chrono::nanoseconds(1000000000ll/hz);
+    const auto entered=Clock::now();
+    if(last_exit!=Clock::time_point{}) busy_ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(entered-last_exit).count();
+    if(deadline==Clock::time_point{} || entered>deadline+8*period) deadline=entered; // resync after a long stall
+    else deadline+=period;
+    if(entered>deadline) ++late;
+    // Coarse wait through the scheduler (the baton is released), the last ~1.5 ms spin.
+    const auto coarse=deadline-std::chrono::microseconds(1500);
+    if(Clock::now()<coarse) uc::os_sched().sleep_ticks(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(coarse-Clock::now()).count())*uc::kTimebaseHz/1000000000ull/uc::clock_speed());
+    while(Clock::now()<deadline) {}
+    const auto now=Clock::now();
+    wait_ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(now-entered).count();
+}
+float dt() {
+    const auto now=Clock::now();
+    double step=last_boundary==Clock::time_point{} ? 1.0/hz : std::chrono::duration<double>(now-last_boundary).count();
+    last_boundary=now;
+    step=step<1.0/1000 ? 1.0/1000 : step>1.0/20 ? 1.0/20 : step;
+    ++frames; dt_sum+=step;
