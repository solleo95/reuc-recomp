+// SPIKE-240 sampler: RIP of the guest main thread every ~0.5 ms -> spike-samples.txt ("rva count"), resolved offline through a linker map.
+void start_sampler() {
+    static bool started=false; if(started) return; started=true;
+    HANDLE target=nullptr;
+    DuplicateHandle(GetCurrentProcess(),GetCurrentThread(),GetCurrentProcess(),&target,0,FALSE,DUPLICATE_SAME_ACCESS);
+    std::thread([target] {
+        const auto base=reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        std::vector<uint32_t> hist(8u<<20); auto last=Clock::now(); // no allocation while the target is suspended (it may hold the heap lock)
