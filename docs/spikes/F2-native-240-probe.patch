+            if(GetThreadContext(target,&ctx)) { const uint64_t rva=ctx.Rip-base; if((rva>>3)<hist.size()) ++hist[rva>>3]; }
+            ResumeThread(target);
+            if(Clock::now()-last>=std::chrono::seconds(1)) {
+                last=Clock::now();
