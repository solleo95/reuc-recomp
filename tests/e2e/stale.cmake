file(MAKE_DIRECTORY ${OUT})
file(WRITE ${OUT}/game_999.cpp "stale shard from an older run")
execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --out ${OUT} --shard 100000 RESULT_VARIABLE r)
if(r)
  message(FATAL_ERROR "translator failed (${r})")
endif()
if(NOT EXISTS ${OUT}/game_999.cpp)
  message(FATAL_ERROR "translator deleted a preserved shard")
endif()
file(READ ${OUT}/game_999.cpp stale)
if(NOT stale STREQUAL "stale shard from an older run")
  message(FATAL_ERROR "translator modified an inactive shard")
endif()
include(${OUT}/game_sources.cmake)
list(FIND UC_GENERATED_SOURCES "${OUT}/game_999.cpp" stale_index)
list(LENGTH UC_GENERATED_SOURCES active_count)
if(NOT stale_index EQUAL -1 OR NOT active_count EQUAL 2)
  message(FATAL_ERROR "active source list includes stale shards or misses current outputs")
endif()
foreach(source IN LISTS UC_GENERATED_SOURCES)
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "active generation references missing source ${source}")
  endif()
endforeach()
