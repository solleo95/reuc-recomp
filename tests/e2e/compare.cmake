foreach(i a b)
  execute_process(COMMAND ${TRANSLATOR} --dol ${DOL} --out ${OUT}/${i} --shard 100000 RESULT_VARIABLE r)
  if(r)
    message(FATAL_ERROR "translator failed (${r})")
  endif()
endforeach()
file(GLOB files RELATIVE ${OUT}/a ${OUT}/a/*)
list(LENGTH files n)
if(n LESS 3)
  message(FATAL_ERROR "translator produced only ${n} files")
endif()
foreach(f ${files})
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/a/${f} ${OUT}/b/${f} RESULT_VARIABLE r)
  if(r)
    message(FATAL_ERROR "translator output differs between two runs: ${f}")
  endif()
endforeach()
